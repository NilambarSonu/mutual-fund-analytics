# pyenv
#   For a library or app, you might want to share your .python-version if the
#   project is co-developed in multiple versions of Python.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if the platform is not the same, the lock file will be different
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock contains specific versions, but may be shared
#poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock contains specific versions, but may be shared
#pdm.lock

# PEP 582; used by e.g. github.com/lincolnloop/layman and github.com/pdm-project/pdm
